
# ── Queue ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=guest.invited
CONSUMER_GROUP=notification-workers
CONSUMER_NAME=notifier-1

# ── SMTP (Gmail for testing) ─────────────────────────────────
# Leave SMTP_USER / SMTP_PASSWORD blank to run in log-only mode: every
# email is printed to the worker log instead of being sent.
# For Gmail, SMTP_PASSWORD must be a 16-char App Password (Google Account →
# Security → 2-Step Verification → App passwords), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address — defaults to SMTP_USER. Gmail replaces any address that
# isn't the signed-in account or one of its verified aliases.
SENDER_EMAIL=
