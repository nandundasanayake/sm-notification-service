
# ── Queue ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
STREAM_NAME=guest.invited
CONSUMER_GROUP=notification-workers
CONSUMER_NAME=notifier-1

# ── AWS SES ──────────────────────────────────────────────────
# Leave blank to run in log-only mode: every email is printed to the
# worker log instead of being sent. In SES sandbox mode both the sender
# and each recipient must be verified identities.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
SES_SENDER_EMAIL=no-reply@scanme.app
